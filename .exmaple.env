# DATABASE_URL is the connection string for your PostgreSQL database. It should be in the format:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/openfeedback_db?schema=public"

# BETTER_AUTH_SECRET is a random string used to sign authentication tokens. You should change this to a secure, random value in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app